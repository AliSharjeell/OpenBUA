{
  "manifest_version": 3,
  "name": "OpenBUA - Open Browser Use Agent",
  "version": "1.3.0",
  "description": "Autonomous browser use Chrome extension that navigates, researches, interacts, and fills forms directly in your everyday browser.",
  "permissions": [
    "activeTab",
    "tabs",
    "sidePanel",
    "storage",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Open OpenBUA Assistant"
    }
  },
  "action": {
    "default_title": "Open OpenBUA",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
